
{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    },
    "api/hackathon.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/:path((?!hackathon$).*)",
      "destination": "/api"
    },
    {
      "source": "/registrations",
      "destination": "/api"
    },
    {
      "source": "/registrations/",
      "destination": "/api"
    },
    {
      "source": "/:path((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
